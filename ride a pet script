    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.Text = name .. "  |  NOT FOUND"
    button.LayoutOrder = index
    button.AutoButtonColor = false
    button.Parent = scroll

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 7)
    buttonCorner.Parent = button

    buttons[name] = button

    button.MouseButton1Click:Connect(function()
        if findEgg(name) then
            teleportToEgg(name)
        end
    end)
end

-- Update one egg
local function updateButton(name)

    local button = buttons[name]

    if not button then
        return
    end

    if findEgg(name) then

        button.Text = name .. "  |  ACTIVE"
        button.BackgroundColor3 = Color3.fromRGB(35, 145, 70)
        button.TextColor3 = Color3.fromRGB(255, 255, 255)

    else

        button.Text = name .. "  |  NOT FOUND"
        button.BackgroundColor3 = Color3.fromRGB(75, 40, 40)
        button.TextColor3 = Color3.fromRGB(190, 190, 190)

    end
end

-- Update all eggs
local function updateAll()

    for _, name in ipairs(eggNames) do
        updateButton(name)
    end

end

updateAll()

