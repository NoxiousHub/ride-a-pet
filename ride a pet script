for index, name in ipairs(eggNames) do

    local button = Instance.new("TextButton")

    button.Name = name:gsub("%s+", "_")
    button.Size = UDim2.new(1, -5, 0, 43)

    button.BackgroundColor3 = COLORS.NotFound
    button.BorderSizePixel = 0

    button.TextColor3 = COLORS.NotFoundText
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold

    button.Text = name .. "  |  NOT FOUND"
    button.LayoutOrder = index
    button.AutoButtonColor = false
    button.Parent = scroll

    local buttonCorner = Instance.new("UICorner")
    buttonCorner.CornerRadius = UDim.new(0, 8)
    buttonCorner.Parent = button

    local buttonStroke = Instance.new("UIStroke")
    buttonStroke.Color = COLORS.PurpleDark
    buttonStroke.Thickness = 1
    buttonStroke.Transparency = 0.7
    buttonStroke.Parent = button

    buttons[name] = button

    button.MouseButton1Click:Connect(function()

        if findEgg(name) then
            teleportToEgg(name)
        end

    end)

end

--//==================================================
--// UPDATE ONE EGG
--//==================================================

local function updateButton(name)

    local button = buttons[name]

    if not button then
        return
    end

    if findEgg(name) then

        button.Text = name .. "  |  ACTIVE"
        button.BackgroundColor3 = COLORS.Active
        button.TextColor3 = COLORS.ActiveText

    else

        button.Text = name .. "  |  NOT FOUND"
        button.BackgroundColor3 = COLORS.NotFound
        button.TextColor3 = COLORS.NotFoundText

    end
end

--//==================================================
--// UPDATE ALL
--//==================================================

local function updateAll()

    for _, name in ipairs(eggNames) do
        updateButton(name)
    end

end

updateAll()

