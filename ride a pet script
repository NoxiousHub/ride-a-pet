-- Find egg
local function findEgg(name)
    return eggsFolder:FindFirstChild(name)
end

-- Teleport to egg
local function teleportToEgg(name)
    local egg = findEgg(name)
    local character = player.Character

    if not egg or not character then
        return
    end

    local success, pivot = pcall(function()
        return egg:GetPivot()
    end)

    if success then
        character:PivotTo(pivot + Vector3.new(0, 5, 0))
    end
end

-- Teleport to BASE
local function teleportToBase()
    local plots = workspace:FindFirstChild("Plots")
    local plot = plots and plots:FindFirstChild("Plot")
    local character = player.Character

    if not plot or not character then
        return
    end

    local success, pivot = pcall(function()
        return plot:GetPivot()
    end)

    if success then
        character:PivotTo(pivot + Vector3.new(0, 5, 0))
    elseif plot:IsA("BasePart") then
        character:PivotTo(plot.CFrame + Vector3.new(0, 5, 0))
    end
end

-- Teleport to MIDDLE
local function teleportToMiddle()
    local children = workspace:GetChildren()
    local middle = children[58]
    local character = player.Character

    if not middle or not character then
        return
    end

    local success, pivot = pcall(function()
        return middle:GetPivot()
    end)

    if success then
        character:PivotTo(pivot + Vector3.new(0, 5, 0))
    elseif middle:IsA("BasePart") then
        character:PivotTo(middle.CFrame + Vector3.new(0, 5, 0))
    end
end

